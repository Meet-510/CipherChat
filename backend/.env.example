# Copy to backend/.env for local dev, or set these in the Render dashboard for production.
# NEVER commit the real backend/.env (it is gitignored).

# --- Required ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
JWT_SECRET=<a-long-random-string>

# Production only: set NODE_ENV=production on Render (enables serving the built
# frontend + secure cookies). Leave unset / "development" for local dev.
NODE_ENV=development

# Local dev uses 5001; on Render, PORT is provided automatically (do not hardcode).
PORT=5001

# Production: your live app origin, e.g. https://cipherchat.onrender.com
# Dev: leave unset (defaults to http://localhost:5173)
# CLIENT_URL=

# --- Cloudinary (required for photo/video messages + profile pictures) ---
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# --- Email (optional; only needed for Forgot Password) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=<your-email>
# EMAIL_PASS=<app-password>
# EMAIL_FROM="CipherChat <your-email>"
